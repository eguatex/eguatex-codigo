{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "barra-matematica.schema.json",
  "title": "Barra Matematica: categorias padrao e atalhos exportados pelo usuario",
  "oneOf": [
    { "$ref": "#/$defs/padrao" },
    { "$ref": "#/$defs/exportacao" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,40}$"
    },
    "botao": {
      "type": "object",
      "required": ["comando"],
      "properties": {
        "rotulo": { "type": "string", "minLength": 1, "maxLength": 40 },
        "comando": { "type": "string", "minLength": 2, "maxLength": 2000 },
        "acao": {
          "type": "string",
          "enum": [
            "matematica-linha",
            "matematica-destaque",
            "ambiente-equation",
            "ambiente-align",
            "ambiente-gather",
            "ambiente-cases",
            "ambiente-pmatrix-2x2",
            "ambiente-pmatrix-3x3",
            "ambiente-integral",
            "ambiente-fracao"
          ]
        }
      },
      "additionalProperties": false
    },
    "botaoUsuario": {
      "type": "object",
      "required": ["comando"],
      "properties": {
        "rotulo": { "type": "string", "minLength": 1, "maxLength": 40 },
        "comando": { "type": "string", "minLength": 2, "maxLength": 2000 }
      },
      "additionalProperties": false
    },
    "nome": { "type": "string", "minLength": 1, "maxLength": 40 },
    "padrao": {
      "type": "object",
      "required": ["categorias"],
      "properties": {
        "categorias": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "botoes"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "botoes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/botao" } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "exportacao": {
      "type": "object",
      "required": ["formato", "versao"],
      "properties": {
        "formato": { "type": "string", "enum": ["eguatex-atalhos"] },
        "versao": { "type": "integer", "enum": [1] },
        "categorias": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "nome", "botoes"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "nome": { "$ref": "#/$defs/nome" },
              "botoes": { "type": "array", "items": { "$ref": "#/$defs/botaoUsuario" } }
            },
            "additionalProperties": false
          }
        },
        "extras": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/botaoUsuario" } }
        },
        "nomes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/nome" }
        },
        "ocultas": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "ordem": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "macros": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["texto", "codigo"],
            "properties": {
              "texto": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^\\S+$" },
              "codigo": { "type": "string", "minLength": 1, "maxLength": 2000 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
